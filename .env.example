# Copy to .env (never commit .env) and fill in.

# Public address of the server. A real domain gets an HTTPS certificate automatically.
# For a trial run on one machine use:  DOMAIN=http://localhost
DOMAIN=schedule.example.edu

# Database password: long and random, e.g.  openssl rand -base64 24
DB_PASSWORD=

# Token for /api/v1/admin/** (semesters, pinning files, manual imports). Long and random, e.g.  openssl rand -hex 32
# Leave empty to switch the administrative API off completely.
VSUET_ADMIN_TOKEN=

# true = serve Swagger UI and /v3/api-docs publicly
SWAGGER_ENABLED=false

# Database backups: where they are written, how many days to keep, how often (hours)
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
